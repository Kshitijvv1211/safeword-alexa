# Copy this file to .env (it is git-ignored). npm scripts load .env automatically.

# Server
PORT=8787
HOST=127.0.0.1
# DATA_DIR=./data
# Set to 0 to disable the /demo/tamper route
DEMO_MODE=1

# Security (Streamable HTTP spec). Browser Origins other than this server's own are refused
# with 403 unless listed here (comma-separated).
# ALLOWED_ORIGINS=https://my-host.example
# Require "Authorization: Bearer <token>" on /mcp. Open the simulator as /#token=<token>.
# MCP_AUTH_TOKEN=

# Amazon Bedrock (AWS Builder). `npm run dev:bedrock` turns it on; `npm run bedrock:check` tests it.
# Credentials: an IAM user's access key with bedrock:InvokeModel permission.
# Skip these two lines if you use `aws configure` or AWS_PROFILE instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_TIMEOUT_MS=8000
# USE_BEDROCK=1   (same as npm run dev:bedrock)
